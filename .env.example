# Secrets for live trading. Dry-run needs none of these.

# ----- Perpl (create at https://app.perpl.xyz/apikeys or testnet.perpl.xyz)
# Key needs the "trade" scope; you also need a funded exchange account.
PERPL_API_KEY=your-x-api-key-token
PERPL_API_PRIVATE_KEY=your-ed25519-private-key   # 32-byte seed, hex or base64

# ----- Variational (create at https://testnet.variational.io/app/settings)
VARIATIONAL_API_KEY=your-key
VARIATIONAL_API_SECRET=your-secret

# ----- Arcus (register your Ed25519 key in the Arcus app; see docs.arcus.xyz)
ARCUS_API_KEY=your-key
ARCUS_PRIVATE_KEY=your-ed25519-private-key       # 32-byte seed, hex or base64

# ----- Phoenix: no API key — signing uses the Solana keypair file
# configured as venues.phoenix.keypair_path in config.yaml.
