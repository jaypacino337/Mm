# Create an API key at https://app.perpl.xyz/apikeys (mainnet)
# or https://testnet.perpl.xyz/apikeys (testnet).
# The key needs the "trade" scope for live trading; "read" is enough for dry runs.
#
# NOTE: enrolling an API key does NOT create a trading account. You must also
# create an exchange account with collateral via the Perpl web app before the
# bot can place orders.

PERPL_API_KEY=your-x-api-key-token
# 32-byte Ed25519 private key seed, hex or base64
PERPL_API_PRIVATE_KEY=your-ed25519-private-key
